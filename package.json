{
  "name": "@sugusdaddy/solana-tx-simulator",
  "version": "1.0.0",
  "description": "Transaction simulation engine for Solana - Predict state changes and detect risks before signing",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.0",
    "@solana/spl-token": "^0.4.6",
    "bs58": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.2.0"
  },
  "keywords": ["solana", "simulation", "security", "wallet", "transaction", "blowfish", "phantom"],
  "author": "Sugusdaddy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sugusdaddy/solana-tx-simulator"
  }
}
